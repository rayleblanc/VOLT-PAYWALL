{
  "name": "volt-paywall-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create volt-paywall-d1",
    "d1:migrate:local": "wrangler d1 migrations apply volt-paywall-d1 --local",
