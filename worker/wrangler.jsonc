{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "volt-paywall",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "volt-paywall-db",
      "database_id": "c9e2a3d2-5326-4fa8-b118-2fe8b9c6a1e7"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "PRODUCT_PAYLOAD_KV",
      "id": "13b740c4c9b944408b236b8e96d2c9e8"
  ],
  "vars": {
    "PAYMENT_RECIPIENT": "0x1750C0c093650C36DcF45843446567FF3f50cC5A",
    "BSC_RPC_URL": "https://bsc-dataseed.binance.org/,https://bsc-dataseed1.defibit.io/,https://binance.llamarpc.com",
    "USDT_CONTRACT_ADDRESS": "0x55d398326f99059fF775485246999027B3197955",
    "CHAIN_ID": "56",
    "ALLOWED_ORIGINS": "https://voltpaywall.com,http://localhost:3000,http://127.0.0.1:3000",
    "APP_ENV": "production"
  }
}