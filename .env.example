# ==============================================================================
# VOLT Paywall - Environment Variables & Production Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# General Platform Variables
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Required for Gemini AI Studio runtime if platform AI features are used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet is hosted (e.g., https://my-app.run.app).
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------------------
# Frontend Environment Variables (Vite)
# ------------------------------------------------------------------------------
# VITE_APP_MODE: 'demo' (mock UI), 'local' (connects to worker at http://localhost:8787), or 'production' (same origin /api/*)
VITE_APP_MODE="demo"

# VITE_API_BASE_URL: Optional override for custom API backend domain (e.g., https://api.voltpaywall.com)
VITE_API_BASE_URL=""

# ------------------------------------------------------------------------------
# Blockchain & Cloudflare Worker Configuration
# ------------------------------------------------------------------------------
# PAYMENT_RECIPIENT: The authoritative server-side wallet address that receives USDT payments.
# MUST be set to your real EVM receiving wallet in production.
PAYMENT_RECIPIENT="0x1750C0c093650C36DcF45843446567FF3f50cC5A"

# ------------------------------------------------------------------------------
# BSC Network Setup: Testnet vs Mainnet Reference
# ------------------------------------------------------------------------------
# [BSC TESTNET - CHAIN ID 97]
# BSC_RPC_URL="https://data-seed-prebsc-1-s1.binance.org:8545/"
# USDT_CONTRACT_ADDRESS="0x337610d27c682E347C9cD60BD4b3b107C9d34dDd"

# [BSC MAINNET - CHAIN ID 56]
# BSC_RPC_URL="https://bsc-dataseed.binance.org/"
# USDT_CONTRACT_ADDRESS="0x55d398326f99059fF775485246999027B3197955"

BSC_RPC_URL="https://data-seed-prebsc-1-s1.binance.org:8545/"
USDT_CONTRACT_ADDRESS="0x337610d27c682E347C9cD60BD4b3b107C9d34dDd"

# ------------------------------------------------------------------------------
# Post-Payment Delivery & Security (Google Drive / Cryptographic Download)
# ------------------------------------------------------------------------------
# JWT_SECRET: Strong secret key used to sign one-time 1-hour download tokens for verified orders.
JWT_SECRET="generate_a_random_secure_secret_key_here"

# DRIVE_DELIVERY_URL / SECRET_CONTENT_URL: Your Google Drive link containing the downloadable files.
# Verified paying buyers are cryptographically authorized and seamlessly redirected to download this file.
# Format: https://drive.google.com/file/d/YOUR_DRIVE_FILE_ID/view?usp=sharing (or folder link)
DRIVE_DELIVERY_URL="https://drive.google.com/file/d/YOUR_DRIVE_FILE_ID/view?usp=sharing"
SECRET_CONTENT_URL=""

# RPC_CHUNK_SIZE: Maximum number of blocks to request per eth_getLogs batch (default: 1000)
RPC_CHUNK_SIZE="1000"

